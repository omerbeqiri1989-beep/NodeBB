# ============================================================
# Flawless Roleplay — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ---- NodeBB ----
NODEBB_URL=https://forum.flawlessrp.com
NODEBB_SECRET=change-this-to-a-random-secret-string

# ---- MongoDB ----
MONGO_USER=flawless
MONGO_PASS=change-this-to-a-strong-password
MONGO_DB=flawless_nodebb

# ---- JWT (shared between UCP and Forum for SSO) ----
JWT_SECRET=change-this-to-a-shared-jwt-secret

# ---- UCP ----
UCP_URL=https://ucp.flawlessrp.com
UCP_API_URL=http://ucp:3000
UCP_BUILD_CONTEXT=../flawless-rp-ucp
DATABASE_URL=mysql://user:password@host:3306/flawless_ucp

# ---- Cookie Domain (shared SSO) ----
COOKIE_DOMAIN=.flawlessrp.com

# ---- SA-MP Server ----
SAMP_SERVER_IP=play.flawlessrp.com
SAMP_SERVER_PORT=7777
SAMP_SYNC_INTERVAL=300000
SCRIPTFILES_PATH=/path/to/samp/scriptfiles

# ---- Stripe (Donation Store) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- PayPal (Donation Store) ----
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_SANDBOX=true
